# Copier en .env.local et adapter. Les variables VITE_* sont lues au build par Vite.

# Source des données de l'espace client : mock (défaut, en mémoire) ou http (API REST).
VITE_EKA_API=mock
# Adresse de l'API en mode http. « /api » passe par le proxy de `npm run dev` vers EKA_API_PORT.
VITE_EKA_API_URL=/api

# Serveur de démonstration (`npm run api`), lu au lancement par Node.
EKA_API_PORT=8787
EKA_API_HOST=127.0.0.1
# À renseigner seulement si le front appelle l'API sur une autre origine (ex. http://localhost:5173).
EKA_API_CORS_ORIGIN=
# Durée de vie d'une session, en minutes.
EKA_API_SESSION_MIN=120
