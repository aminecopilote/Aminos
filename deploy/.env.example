# Copied to .env by install.sh (which fills the administrator credentials).
DOMAIN=localhost
AMINOS_ADMIN_USER=admin
AMINOS_ADMIN_PASSWORD=
# 1 lets administrators allow accounts to use third-party model providers (text leaves the server). Default: local only.
AMINOS_ALLOW_REMOTE_LLM=0
# Server-side keys for those providers (never typed by users). Leave empty to stay fully local.
ANTHROPIC_API_KEY=
