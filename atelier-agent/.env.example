# Copy to .env and fill in at least one key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
# Folder(s) holding skills (SKILL.md files), ';' separated on Windows, ':' elsewhere
SKILLS_DIRS=../.claude/skills
